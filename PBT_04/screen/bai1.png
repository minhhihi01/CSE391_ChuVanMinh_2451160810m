<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Cửa Hàng</title>

    <style>
        *{
            margin:0;
            padding:0;
            box-sizing:border-box;
            font-family: Arial, Helvetica, sans-serif;
        }

        body{
            background:#ececec;
        }

        /* HEADER */
        header{
            background:#11132d;
            color:white;
            padding:20px;
            display:flex;
            justify-content:space-between;
            align-items:center;
        }

        .logo{
            font-size:30px;
            font-weight:bold;
        }

        nav ul{
            display:flex;
            list-style:none;
            gap:30px;
        }

        nav a{
            color:white;
            text-decoration:none;
            font-size:18px;
        }

        nav a:hover{
            color:#ff4d4d;
        }

        /* MAIN */
        .container{
            display:flex;
            gap:20px;
            padding:20px;
        }

        /* SIDEBAR */
        .sidebar{
            width:230px;
            background:white;
            border:1px solid #dcdcdc;
            padding:15px;
            height:fit-content;

            position:sticky;
            top:20px;
        }

        .sidebar h3{
            margin-bottom:10px;
        }

        .sidebar ul{
            list-style:none;
        }

        .sidebar li{
            margin:5px 0;
            cursor:pointer;
        }

        .sidebar li:hover{
            color:red;
        }

        /* CONTENT */
        .content{
            flex:1;
        }

        /* PRODUCTS */
        .products{
            display:flex;
            gap:15px;
            margin-bottom:20px;
        }

        .product-card{
            flex:1;
            background:white;
            border:1px solid #ddd;
            border-radius:8px;
            padding:15px;
            position:relative;
        }

        .product-card h3{
            margin-bottom:10px;
        }

        .price{
            color:#ff4d4d;
            font-size:28px;
        }

        .hot{
            position:absolute;
            top:-10px;
            right:-10px;

            width:40px;
            height:40px;
            background:red;
            color:white;

            border-radius:50%;

            display:flex;
            justify-content:center;
            align-items:center;

            font-size:12px;
            font-weight:bold;
        }

        /* DEMO CONTENT */
        .demo-box{
            background:white;
            border:1px solid #ddd;
            padding:20px;
            min-height:160px;
            line-height:2;
        }
    </style>
</head>
<body>

    <!-- HEADER -->
    <header>
        <div class="logo">Cửa Hàng Của Tôi</div>

        <nav>
            <ul>
                <li><a href="#">Trang chủ</a></li>
                <li><a href="#">Sản phẩm</a></li>
                <li><a href="#">Liên hệ</a></li>
            </ul>
        </nav>
    </header>

    <!-- MAIN -->
    <div class="container">

        <!-- SIDEBAR -->
        <aside class="sidebar">
            <h3>Danh mục</h3>

            <ul>
                <li>Điện thoại</li>
                <li>Laptop</li>
                <li>Đồng hồ</li>
                <li>Phụ kiện</li>
            </ul>
        </aside>

        <!-- CONTENT -->
        <main class="content">

            <!-- PRODUCTS -->
            <div class="products">

                <div class="product-card">
                    <div class="hot">HOT</div>
                    <h3>iPhone 15 Pro</h3>
                    <div class="price">28.990.000đ</div>
                </div>

                <div class="product-card">
                    <div class="hot">HOT</div>
                    <h3>MacBook Air M3</h3>
                    <div class="price">32.990.000đ</div>
                </div>

                <div class="product-card">
                    <div class="hot">HOT</div>
                    <h3>AirPods Pro</h3>
                    <div class="price">6.490.000đ</div>
                </div>

            </div>

            <!-- DEMO -->
            <div class="demo-box">
                <p>Nội dung ví dụ để chứng minh sticky</p>
                <p>Nội dung ví dụ để chứng minh sticky</p>
                <p>Nội dung ví dụ để chứng minh sticky</p>
                <p>Nội dung ví dụ để chứng minh sticky</p>
            </div>

        </main>

    </div>

</body>
</html>